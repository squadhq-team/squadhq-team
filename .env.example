# Supabase: Settings > Database > Connection string
# DATABASE_URL = Transaction Pooler (Port 6543) mit ?pgbouncer=true
# DIRECT_URL   = Direct connection (Port 5432), wird für prisma db push gebraucht
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/squadhq"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/squadhq"
