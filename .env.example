# Supabase: Settings > Database > Connection string
# DATABASE_URL = Transaction Pooler (Port 6543) mit ?pgbouncer=true
# DIRECT_URL   = Direct connection (Port 5432), wird für prisma db push gebraucht
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/squadhq"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/squadhq"

# Supabase Auth (Anmeldung, Registrierung, Passwort vergessen): Supabase → Project Settings → API
# Ohne diese beiden Werte kann sich niemand anmelden.
# SUPABASE_URL="https://<projekt>.supabase.co"
# SUPABASE_ANON_KEY="<anon public key>"
# Optional: feste App-Adresse für Links in Mails
# SITE_URL="https://squadhq-omega.vercel.app"

# Push-Benachrichtigungen (optional): Schlüssel einmal erzeugen mit `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY="<public key>"
# VAPID_PRIVATE_KEY="<private key>"
# VAPID_SUBJECT="mailto:<eure Kontakt-Adresse>"
# Erinnerung per E-Mail (optional): Postfach, über das die App Mails verschickt, z. B. Gmail mit App-Passwort
# SMTP_USER="<team-adresse>@gmail.com"
# SMTP_PASS="<16-stelliges App-Passwort>"
# Nur nötig, wenn nicht Gmail: SMTP_HOST (Standard smtp.gmail.com), SMTP_PORT (Standard 587), SMTP_FROM_NAME (Standard SquadHQ)

# Schutz für den täglichen Erinnerungs-Job /api/cron/erinnerungen (lange zufällige Zeichenkette, auch in Vercel eintragen)
# CRON_SECRET="<lange zufällige Zeichenkette>"
